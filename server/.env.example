# Neon Postgres 커넥션 문자열 (콘솔 > Connection Details)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# HS256 대칭키 — 32바이트(base64 인코딩 시 약 44자) 이상 필수
JWT_SECRET=change-me-to-a-random-32-byte-or-longer-secret

# 액세스 토큰 만료 시간(시간 단위)
JWT_EXPIRATION_HOURS=12

# 데모 admin 계정 + 샘플 데이터 시드 여부 (멱등 — 이미 있으면 스킵)
APP_SEED_ENABLED=true

# 프론트 라이브 오리진(쉼표 구분). 와일드카드(*) 금지
CORS_ALLOWED_ORIGINS=http://localhost:5173
